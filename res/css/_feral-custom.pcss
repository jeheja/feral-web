/*
Feral Custom Styling
*/

/* Feral Color Variables */
:root {
  --feral-deep-forest: #0F2C1E;
  --feral-forest-shadow: #0a1f15;
  --feral-golden: #D4AF37;
  --feral-golden-bright: #F1C40F;
  --feral-cream: #FFF8E7;
  --feral-sage-green: #87A96B;
  --feral-moss-green: #4A5D3A;
}

/* Prevent body scroll on auth pages */
body:has(.mx_AuthPage) {
  overflow: hidden;
  height: 100vh;
  margin: 0;
}

/* Override auth page background with Feral forest gradient */
.mx_AuthPage {
  background: linear-gradient(135deg, var(--feral-deep-forest) 0%, var(--feral-forest-shadow) 100%) !important;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* Remove animation - just keep static gradient background */

/* Glass morphism effect for auth modal */
.mx_AuthPage_modal {
  background: rgba(255, 255, 255, 0.05) !important;
  backdrop-filter: blur(20px);
  border: 1px solid rgba(212, 175, 55, 0.2);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3) !important;
}

/* Style auth body with better contrast */
.mx_AuthBody {
  color: var(--feral-cream);
}

.mx_AuthBody h1 {
  color: var(--feral-cream);
  font-weight: 600;
}

/* Golden accents for inputs */
.mx_Field input,
.mx_Field select,
.mx_Field textarea {
  background-color: rgba(255, 255, 255, 0.05);
  border-color: rgba(212, 175, 55, 0.3);
  color: var(--feral-cream);
}

.mx_Field input:focus,
.mx_Field select:focus,
.mx_Field textarea:focus {
  border-color: var(--feral-golden);
  box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.2);
}

.mx_Field input::placeholder {
  color: rgba(255, 248, 231, 0.5);
}

/* Primary button with golden style - but exclude call buttons */
.mx_AccessibleButton_kind_primary:not(.mx_LegacyCallEvent_silence):not(.mx_LegacyCallEvent_unSilence):not(.mx_LegacyCallEvent_answerButton):not(.mx_LegacyCallEvent_rejectButton):not(.mx_CallEvent_Button) {
  background: var(--feral-golden) !important;
  color: var(--feral-deep-forest) !important;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.mx_AccessibleButton_kind_primary:not(.mx_LegacyCallEvent_silence):not(.mx_LegacyCallEvent_unSilence):not(.mx_LegacyCallEvent_answerButton):not(.mx_LegacyCallEvent_rejectButton):not(.mx_CallEvent_Button):hover {
  background: var(--feral-golden-bright) !important;
  box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
  transform: translateY(-2px);
}

/* Keep call buttons in their default green color */
.mx_LegacyCallEvent_answerButton,
.mx_LegacyCallEvent_answerButton:hover,
.mx_CallEvent_Button.mx_CallEvent_Button_answer,
.mx_CallEvent_Button.mx_CallEvent_Button_answer:hover {
  background: var(--cpd-color-bg-action-primary-rest) !important;
  color: white !important;
}

.mx_LegacyCallEvent_rejectButton,
.mx_LegacyCallEvent_rejectButton:hover,
.mx_CallEvent_Button.mx_CallEvent_Button_reject,
.mx_CallEvent_Button.mx_CallEvent_Button_reject:hover {
  background: var(--cpd-color-bg-critical-primary) !important;
  color: white !important;
}

/* Link buttons with golden color */
.mx_AccessibleButton_kind_link,
.mx_AccessibleButton_kind_link_inline {
  color: var(--feral-golden) !important;
}

.mx_AccessibleButton_kind_link:hover,
.mx_AccessibleButton_kind_link_inline:hover {
  color: var(--feral-golden-bright) !important;
  text-decoration: underline;
}

/* Server picker styling */
.mx_ServerPicker {
  border-color: rgba(212, 175, 55, 0.3);
  background: rgba(255, 255, 255, 0.05);
}

.mx_ServerPicker_server {
  color: var(--feral-cream);
}

/* Error messages */
.mx_Login_error {
  background: rgba(220, 53, 69, 0.1);
  border: 1px solid rgba(220, 53, 69, 0.3);
  color: #ff6b6b;
}

/* Auth header logo styling - override Element defaults */
.mx_AuthHeaderLogo {
  margin-top: 0 !important;
  padding: 0 !important;
  flex: none !important;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30px;
}

.mx_AuthHeaderLogo img {
  max-height: 140px !important;
  width: auto !important;
  display: block;
}

/* External signup button styling */
.mx_AuthBody_external-signup {
  margin-top: 24px;
  text-align: center;
  padding-top: 24px;
  border-top: 1px solid rgba(212, 175, 55, 0.2);
}

.mx_AuthBody_external-signup p {
  color: rgba(255, 248, 231, 0.7);
  margin-bottom: 16px;
}

.mx_AuthBody_external-signup-button {
  display: inline-block;
  padding: 12px 32px;
  background: transparent;
  border: 2px solid var(--feral-golden);
  border-radius: 50px;
  color: var(--feral-golden);
  text-decoration: none;
  font-weight: 600;
  transition: all 0.3s ease;
  cursor: pointer;
}

.mx_AuthBody_external-signup-button:hover {
  background: rgba(212, 175, 55, 0.1);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
}

/* Hide the original create account link when registration is disabled */
.mx_Login .mx_AuthBody_changeFlow {
  display: none;
}

/* Hide the Powered by Matrix link in footer */
.mx_AuthFooter {
  display: none;
}

/* Position language selector at bottom of left panel */
.mx_AuthHeader {
  justify-content: space-between !important;
}

.mx_AuthBody_language {
  margin-top: auto;
}

/* HomePage logo styling - make it 200px */
.mx_HomePage_default img {
  height: 200px !important;
  filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.3));
  margin-bottom: 20px;
}

/* HomePage title styling to match Feral theme */
.mx_HomePage_default h1 {
  color: var(--feral-deep-forest);
  font-size: 36px !important;
  margin-top: 20px;
}

.mx_HomePage_default h2 {
  color: var(--feral-moss-green);
  font-size: 20px !important;
}

/* HomePage buttons with Feral theme */
.mx_HomePage_default_buttons .mx_AccessibleButton {
  background-color: var(--feral-golden) !important;
  color: var(--feral-deep-forest) !important;
  transition: all 0.3s ease;
}

.mx_HomePage_default_buttons .mx_AccessibleButton:hover {
  background-color: var(--feral-golden-bright) !important;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
}

.mx_HomePage_default_buttons .mx_AccessibleButton::before {
  background-color: var(--feral-deep-forest) !important;
}

/* Responsive adjustments */
@media only screen and (max-width: 768px) {
  .mx_AuthHeaderLogo img {
    max-height: 60px;
  }
  
  .mx_AuthPage_modal {
    margin: 20px;
    border-radius: 16px;
  }
  
  .mx_HomePage_default img {
    height: 120px !important;
  }
}